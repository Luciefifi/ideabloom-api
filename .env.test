# Settings for automated tests (used when NODE_ENV=test, which Jest sets automatically).
# This file IS committed: it only points at the throwaway local test database
# from docker-compose.yml and must never contain real secrets.

NODE_ENV=test
PORT=4001
DATABASE_URL=postgres://ideabloom:ideabloom_test@localhost:5443/ideabloom_test

# Fake secret for tests only. Never use this value anywhere real.
JWT_ACCESS_SECRET=test-only-secret-not-for-real-use-0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REGISTRATION_ENABLED=true
# High limits so tests aren't throttled; the rate-limit test lowers them itself.
RATE_LIMIT_DEFAULT=10000
RATE_LIMIT_AUTH=10000
TRUST_PROXY=loopback
