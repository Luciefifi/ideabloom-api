# Copy this file to `.env` and adjust if needed:   copy .env.example .env
# `.env` is ignored by Git. Never commit real secrets.
# All variables are validated at startup (src/config/env.validation.ts).

# development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# PostgreSQL connection URL (matches the `db` service in docker-compose.yml)
DATABASE_URL=postgres://ideabloom:ideabloom_dev@localhost:5442/ideabloom

# --- Authentication ---
# Long random secret for signing access tokens (min 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-chars
# Access token lifetime in seconds (default 900 = 15 minutes)
JWT_ACCESS_TTL_SECONDS=900
# How long you stay logged in, in days (default 30)
REFRESH_TOKEN_TTL_DAYS=30
# Allow new accounts to be created (set to false in production after creating yours)
REGISTRATION_ENABLED=true

# --- Rate limiting (requests per minute per IP) ---
RATE_LIMIT_DEFAULT=300
RATE_LIMIT_AUTH=5

# Which proxies to trust for the real visitor IP: loopback | false | <number of hops>
TRUST_PROXY=loopback

# How long a password reset link stays valid, in minutes (default 30)
PASSWORD_RESET_TTL_MINUTES=30

# --- Web app & email ---
# Where the web app runs (used to build links in emails)
WEB_APP_URL=http://localhost:3000
# Outgoing email. These defaults send to Mailpit (http://localhost:8025) from docker-compose.yml.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=IdeaBloom <no-reply@ideabloom.local>

# --- Per-account limits (work even if an attacker changes IP) ---
# Failed logins per email before that account's login is paused, and for how long
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_MINUTES=15
# Password reset emails per email address per hour
PASSWORD_RESET_EMAILS_PER_HOUR=3
